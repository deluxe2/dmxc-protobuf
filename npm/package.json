{
  "name": "@deluxequadrat/dmxc-grpc-client",
  "version": "1.0.2",
  "description": "Protobuf client library for DMXC 3",
  "scripts": {
    "build": "./gen-source.sh && tsc"
  },
  "author": "Samuel Hufen",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "ts-proto": "^2.7.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.1",
    "@grpc/grpc-js": "^1.13.3"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deluxe2/dmxc-protobuf.git",
    "directory": "npm"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
	  ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
	  "./*": { "types": "./dist/index.*.d.ts", "default": "./dist/index.*.js" }
  }
}
